##########################
# .NET (LibraryManagementApi)
##########################
bin/
obj/
out/

# Defensive: dotnet-ef's design-time build host occasionally creates a
# literally-named "bin\Debug" directory on Linux/macOS (backslash as a
# regular character, not a path separator) instead of bin/Debug.
bin\\Debug/
*.user
*.userosscache
*.suo
*.userprefs
.vs/

# Build results
[Dd]ebug/
[Rr]elease/
[Xx]64/
[Xx]86/
[Ll]og/
[Ll]ogs/

# Local secrets / environment overrides (never commit real connection strings, keys, passwords)
appsettings.Local.json
appsettings.*.Local.json
appsettings.Production.json
*.pfx
secrets.json

##########################
# Node / Vite (library-management-web)
##########################
node_modules/
dist/
dist-ssr/
*.local

# Env files (may contain API URLs/keys per environment)
.env
.env.*
!.env.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

##########################
# Editor / OS
##########################
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
notes.md